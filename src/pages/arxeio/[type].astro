---
import Base from '../../layouts/Base.astro';
import FilterBar from '../../components/FilterBar.astro';
import RegisterTable from '../../components/RegisterTable.astro';
import { allThemata } from '../../lib/themata';
import { typePlural, typeSlugs } from '../../lib/topics';

export async function getStaticPaths() {
  const items = await allThemata();
  return (Object.keys(typeSlugs) as (keyof typeof typeSlugs)[])
    .filter((t) => items.some((i) => i.data.type === t))
    .map((t) => ({ params: { type: typeSlugs[t] }, props: { t, items } }));
}
const { t, items } = Astro.props;
const filtered = items.filter((i) => i.data.type === t);
---
<Base title={`${typePlural[t]} · Αρχείο`} current="/arxeio/">
  <section class="wrap page">
    <h1>{typePlural[t]}</h1>
    <p class="dek"><a href="/arxeio/">Αρχείο</a>, φιλτραρισμένο: {filtered.length === 1 ? '1 θέμα' : `${filtered.length} θέματα`}.</p>
    <FilterBar items={items} current={t} />
    <RegisterTable items={filtered} />
  </section>
</Base>
<style>
  .page { padding-top: var(--s-7); }
  h1 { font-size: var(--fs-title); }
  .dek { margin: var(--s-3) 0 var(--s-6); color: var(--fg-soft); font-size: var(--fs-dek); }
</style>
