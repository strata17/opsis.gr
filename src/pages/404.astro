---
import Base from '../layouts/Base.astro';
import { copy } from '../lib/copy';
import Arrow from '../components/Arrow.astro';
---
<Base title={copy.notFound.title} sample={false}>
  <section class="wrap nf">
    <h1>{copy.notFound.title}</h1>
    <p>{copy.notFound.body}</p>
    <ul>
      <li><a href="/">{copy.notFound.week}<Arrow /></a></li>
      <li><a href="/#arxeio">{copy.notFound.archive}<Arrow /></a></li>
    </ul>
  </section>
</Base>
<style>
  .nf { padding-block: var(--s-9) var(--s-7); max-width: calc(40rem + 2 * var(--gutter)); }
  h1 { font-size: var(--fs-title); }
  p { margin: var(--s-4) 0 var(--s-6); color: var(--fg-soft); font-size: var(--fs-dek); }
  ul { list-style: none; }
  li a { display: inline-block; padding: var(--s-2) 0; font-weight: 500; text-decoration-thickness: 1px; }
  li a:hover { text-decoration-color: var(--accent); }
</style>
