---
export const prerender = false;
import Admin from '../../layouts/Admin.astro';
import { youtube } from '../../lib/analytics/youtube';
import { instagram } from '../../lib/analytics/instagram';
import { tiktok } from '../../lib/analytics/tiktok';
import { shortDate } from '../../lib/format';

const platforms = await Promise.all([tiktok(), instagram(), youtube()]);
const ok = platforms.filter((p) => p.status === 'ok');
const total = ok.reduce((n, p) => n + (p.followers ?? 0), 0);
const n = (v?: number) => (v == null ? '—' : v.toLocaleString('el-GR'));
const now = new Date().toLocaleString('el-GR', { timeZone: 'Europe/Athens', dateStyle: 'medium', timeStyle: 'short' });
const hint: Record<string, string> = {
  YouTube: 'Έλεγξε ότι το YOUTUBE_API_KEY είναι API key (ξεκινά με «AIza»), όχι OAuth client ID, ότι το YouTube Data API v3 είναι ενεργό στο ίδιο project, και ότι το key δεν έχει περιορισμό «HTTP referrers». Μετά κάνε Redeploy.',
  Instagram: 'Το access token διαρκεί 60 ημέρες. Αν έληξε, φτιάξε νέο long-lived token και αντικατέστησε το INSTAGRAM_ACCESS_TOKEN.',
  TikTok: 'Αν το refresh token έληξε ή ανακλήθηκε, σύνδεσε ξανά την εφαρμογή και αντικατέστησε το TIKTOK_REFRESH_TOKEN.',
};
const setup: Record<string, string> = {
  TikTok: 'TikTok for Developers: εφαρμογή με Login Kit και τα scopes user.info.stats, video.list. Σύνδεση μία φορά για refresh token (ισχύει 365 ημέρες).',
  Instagram: 'Λογαριασμός Business ή Creator συνδεδεμένος με σελίδα Facebook. Meta for Developers: long-lived access token (60 ημέρες) και το Instagram user ID.',
  YouTube: 'Google Cloud Console: ενεργοποίησε το YouTube Data API v3 και δημιούργησε API key.',
};
---
<Admin title="Αναλυτικά" signedIn>
  <header class="head">
    <h1>Αναλυτικά</h1>
    <p class="mono">Ενημέρωση: {now} · ζωντανά από τα API</p>
  </header>

  <section class="totals rule-top-strong" aria-label="Σύνοψη">
    <div><span class="big">{ok.length ? n(total) : "—"}</span><span class="lbl">ακόλουθοι συνολικά{ok.length < platforms.length && ` (${ok.length} από ${platforms.length} πλατφόρμες)`}</span></div>
    {platforms.map((p) => (
      <div><span class="mid">{p.status === 'ok' ? n(p.followers) : '—'}</span><span class="lbl">{p.name}</span></div>
    ))}
  </section>

  {platforms.map((p) => (
    <section class="platform rule-top-strong" aria-labelledby={`h-${p.name}`}>
      <div class="ph">
        <h2 id={`h-${p.name}`}>{p.name}</h2>
        {p.status === 'ok' && <a class="mono" href={p.url} rel="noopener">{p.handle}</a>}
      </div>

      {p.status === 'missing' && (
        <div class="state">
          <p><strong>Δεν έχει συνδεθεί.</strong> {setup[p.name]}</p>
          <p class="mono">Μεταβλητές στο Vercel: {p.needs.join(' · ')}</p>
        </div>
      )}
      {p.status === 'error' && (
        <div class="state error" role="alert">
          <p><strong>Η σύνδεση απέτυχε.</strong> Το {p.name} απάντησε: «{p.message}».</p>
          <p>{hint[p.name]}</p>
        </div>
      )}
      {p.status === 'ok' && (<>
        <dl class="stats">
          <div><dt>Ακόλουθοι</dt><dd>{n(p.followers)}</dd></div>
          {p.totalViews != null && <div><dt>Προβολές συνολικά</dt><dd>{n(p.totalViews)}</dd></div>}
          {p.totalLikes != null && <div><dt>Likes συνολικά</dt><dd>{n(p.totalLikes)}</dd></div>}
          <div><dt>Δημοσιεύσεις</dt><dd>{n(p.posts)}</dd></div>
        </dl>
        {p.recent.length > 0 ? (
          <div class="scroll">
            <table>
              <caption>Τελευταίες δημοσιεύσεις</caption>
              <thead><tr class="mono"><th scope="col">Ημ/νία</th><th scope="col">Δημοσίευση</th><th scope="col" class="r">Προβολές</th><th scope="col" class="r">Likes</th><th scope="col" class="r">Σχόλια</th>{p.name === 'TikTok' && <th scope="col" class="r">Κοινοποιήσεις</th>}</tr></thead>
              <tbody>
                {p.recent.map((r) => (
                  <tr>
                    <td class="mono">{r.date ? shortDate(r.date) : '—'}</td>
                    <th scope="row">{r.url ? <a href={r.url} rel="noopener">{r.title}</a> : r.title}</th>
                    <td class="r num">{n(r.views)}</td><td class="r num">{n(r.likes)}</td><td class="r num">{n(r.comments)}</td>
                    {p.name === 'TikTok' && <td class="r num">{n(r.shares)}</td>}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : <p class="empty">Δεν υπάρχουν ακόμη δημοσιεύσεις.</p>}
      </>)}
    </section>
  ))}

  <section class="platform rule-top-strong">
    <div class="ph"><h2>Ιστότοπος</h2></div>
    <p class="state">Η επισκεψιμότητα του opsismedia.gr μετριέται με το Vercel Web Analytics, χωρίς cookies. <a href="https://vercel.com/strataridakis/opsis-gr/analytics" rel="noopener">Άνοιξε τα στατιστικά στο Vercel</a>.</p>
  </section>
</Admin>
<style>
  .head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: var(--s-3); margin-bottom: var(--s-6); }
  h1 { font-size: var(--fs-title); }
  .totals { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: var(--s-6); padding-block: var(--s-5) var(--s-7); }
  .totals div { display: flex; flex-direction: column; gap: var(--s-2); }
  .big { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-display); line-height: 1; font-variant-numeric: lining-nums; }
  .mid { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h2); line-height: 1; }
  .lbl { color: var(--fg-muted); font-size: var(--fs-small); }
  .platform { padding-block: var(--s-5) var(--s-7); }
  .ph { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--s-4); }
  h2 { font-size: var(--fs-h2); }
  .state { max-width: 62ch; color: var(--fg-soft); }
  .state p + p { margin-top: var(--s-2); }
  .state strong { color: var(--fg); }
  .error strong { color: var(--accent); }
  .stats { display: flex; gap: var(--s-7); flex-wrap: wrap; margin-bottom: var(--s-5); }
  dt { color: var(--fg-muted); font-size: var(--fs-small); }
  dd { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); font-variant-numeric: tabular-nums lining-nums; }
  .scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; min-width: 36rem; }
  caption { text-align: left; font-weight: 600; font-size: var(--fs-small); padding-bottom: var(--s-3); }
  thead tr { box-shadow: inset 0 calc(-1 * var(--hair)) 0 var(--rule-strong); }
  th, td { text-align: left; padding: var(--s-3) var(--s-4) var(--s-3) 0; vertical-align: baseline; }
  thead th { font-weight: 400; }
  tbody tr { box-shadow: inset 0 calc(-1 * var(--hair)) 0 var(--rule); }
  tbody th { font-weight: 400; }
  tbody th a { text-decoration: none; }
  tbody th a:hover { text-decoration: underline; text-decoration-color: var(--accent); }
  .r { text-align: right; }
  .num { font-family: var(--font-mono); font-size: var(--fs-num); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .empty { color: var(--fg-muted); }
  @media (max-width: 720px) { .totals { grid-template-columns: repeat(3, 1fr); } .totals div:first-child { grid-column: 1 / -1; } }
</style>
