---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { allThemata } from '../../lib/themata';

export async function getStaticPaths() {
  const items = await allThemata();
  return items.map((thema) => ({ params: { slug: thema.id }, props: { thema } }));
}
const { thema } = Astro.props;
const { Content } = await render(thema);
---
<Article thema={thema}><Content /></Article>
