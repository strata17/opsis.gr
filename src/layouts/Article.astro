---
import Base from './Base.astro';
import SourceLine from '../components/SourceLine.astro';
import BarFigure from '../components/BarFigure.astro';
import Arrow from '../components/Arrow.astro';
import Headline from '../components/Headline.astro';
import ClaimLedger from '../components/ClaimLedger.astro';
import VideoSlot from '../components/VideoSlot.astro';
import LeadPhoto from '../components/LeadPhoto.astro';
import { copy } from '../lib/copy';
import { longDate } from '../lib/format';
import type { Thema } from '../lib/themata';
interface Props { thema: Thema }
const { thema } = Astro.props;
const d = thema.data;
---
<Base title={d.title} description={d.dek} current="" sample={d.sample} image={`/og/${thema.id}.png`}>
  <article class="wrap article">
    <a class="back" href="/#arxeio"><Arrow dir="left" />{copy.article.back}</a>
    <header class="head">
      <h1><Headline title={d.title} figure={d.keyFigure} /></h1>
      <p class="dek">{d.dek}</p>
      <SourceLine meta={`${copy.types[d.type]} · ${longDate(d.date)}`} text={d.sourceLine} label={d.sources.length > 1 ? copy.sources : copy.source} processed={d.type !== 'sxolio'} />
    </header>

    {d.photo && <div class="block"><LeadPhoto {...d.photo} eager /></div>}

    {d.video && <div class="block video-slot"><VideoSlot {...d.video} /></div>}

    {d.type === 'sxolio' && <p class="note">{copy.commentNote}</p>}

    {d.claims && <div class="block"><ClaimLedger claims={d.claims} size="article" /></div>}

    {d.figure && <div class="block"><BarFigure {...d.figure} /></div>}

    {d.facts && (
      <table class="facts block">
        <tbody>
          {d.facts.map((f, i) => (
            <tr class="rule-top" style={`--i:${i}`}>
              <th scope="row">{f.label}</th><td>{f.value}</td><td class="mono when">{f.when}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    <div class="prose"><slot /></div>

    <section class="apparatus rule-top-strong" aria-labelledby="sources-title">
      <h2 id="sources-title">{copy.article.sources}</h2>
      <ol class="sources">
        {d.sources.map((s) => (
          <li>
            <span class="name">{s.url ? <a href={s.url}>{s.name}</a> : s.name}</span>
            {s.detail && <span class="detail">{s.detail}</span>}
          </li>
        ))}
      </ol>

      {d.method && (<>
        <h2>{copy.article.method}</h2>
        <p class="small">{d.method}</p>
      </>)}

      <h2>{copy.article.corrections}</h2>
      {d.corrections.length === 0 ? (
        <p class="small muted">{copy.article.noCorrections}</p>
      ) : (
        <ul class="corrections">
          {d.corrections.map((c) => <li><span class="mono">{longDate(c.date)}</span> {c.text}</li>)}
        </ul>
      )}
    </section>
  </article>
</Base>
<style>
  .article { max-width: calc(46rem + 2 * var(--gutter)); padding-top: var(--s-6); }
  @media (min-width: 1180px) {
    .article { max-width: calc(46rem + 15rem + var(--s-8) + 2 * var(--gutter)); }
    .article > * { max-width: 46rem; }
    .video-slot { max-width: 30rem; }
  }
  .back { display: inline-block; text-decoration: none; padding-block: var(--s-3); font-size: var(--fs-small); font-weight: 500; }
  .back:hover { text-decoration: underline; text-decoration-color: var(--accent); }
  .head { margin-top: var(--s-6); }
  h1 { font-size: var(--fs-title); line-height: 1.08; letter-spacing: var(--track-display); }
  .dek { margin: var(--s-5) 0 var(--s-4); font-size: var(--fs-dek); line-height: 1.55; color: var(--fg-soft); }
  .note { margin-top: var(--s-6); padding: var(--s-4) var(--s-5); background: var(--surface); font-weight: 500; }
  .block { margin-top: var(--s-7); }
  .facts { width: 100%; border-collapse: collapse; }
  .facts tr:last-child { box-shadow: inset 0 calc(-1 * var(--hair)) 0 var(--rule); }
  .facts th, .facts td { padding: var(--s-3) var(--s-4) var(--s-3) 0; text-align: left; vertical-align: baseline; }
  .facts th { font-weight: 500; }
  .facts .when { text-align: right; padding-right: 0; }
  .prose { margin-top: var(--s-7); max-width: var(--measure); }
  .prose :global(p) { margin-bottom: var(--s-4); }
  .prose :global(figure) { margin: var(--s-6) 0; }
  .prose :global(h2) { font-size: var(--fs-h2); margin: var(--s-7) 0 var(--s-3); }
  .apparatus { margin-top: var(--s-8); padding-top: var(--s-6); }
  .apparatus h2 { font-size: var(--fs-h3); margin: var(--s-6) 0 var(--s-3); }
  .apparatus h2:first-child { margin-top: 0; }
  .sources { padding-left: 1.4em; }
  .sources li { margin-bottom: var(--s-3); padding-left: var(--s-1); }
  .sources li::marker { font-family: var(--font-mono); font-size: var(--fs-num); color: var(--accent); }
  .sources .name { font-weight: 500; }
  .sources .detail { display: block; color: var(--fg-soft); font-size: var(--fs-small); }
  .small { font-size: var(--fs-small); max-width: var(--measure); }
  .muted { color: var(--fg-muted); }
  @media (max-width: 720px) {
    .facts tr { display: grid; grid-template-columns: 1fr auto; column-gap: var(--s-4); padding-block: var(--s-3); }
    .facts th, .facts td { padding: 0; }
    .facts td:nth-child(2) { grid-column: 1 / -1; grid-row: 2; }
    .facts .when { grid-row: 1; grid-column: 2; }
  }
  .corrections { list-style: none; font-size: var(--fs-small); }
</style>
