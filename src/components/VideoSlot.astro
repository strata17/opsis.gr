---
// Link to the short-video version of a piece. Opens the platform; no third-party embed scripts.
import Wordmark from './Wordmark.astro';
import { copy } from '../lib/copy';
interface Props { url: string; platform: string; duration?: string }
const { url, platform, duration } = Astro.props;
---
<a class="video" href={url} rel="noopener">
  <span class="frame" aria-hidden="true">
    <Wordmark tone="marble" size="1.375rem" />
    <svg class="play" viewBox="0 0 40 40" width="40" height="40"><circle cx="20" cy="20" r="19" fill="none" stroke="currentColor" stroke-width="1.25"/><path d="M16 13 L28 20 L16 27 Z" fill="currentColor"/></svg>
  </span>
  <span class="text">
    <span class="t">{copy.video.title}</span>
    <span class="mono">{platform}{duration && ` · ${duration}`}</span>
  </span>
</a>
<style>
  .video { display: grid; grid-template-columns: 5.5rem 1fr; gap: var(--s-5); align-items: center; text-decoration: none; padding-block: var(--s-4); border-block: var(--hair) solid var(--rule); }
  .frame { aspect-ratio: 9 / 16; background: var(--c-ink); color: var(--c-marble); display: flex; flex-direction: column; align-items: center; justify-content: space-between; padding: var(--s-3) 0 var(--s-4); outline: var(--hair) solid var(--rule); }
  .play { transition: transform var(--dur-quick) ease-out; }
  .text { display: flex; flex-direction: column; gap: var(--s-2); }
  .t { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: var(--lh-head); }
  .video:hover .t { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 1.5px; }
  @media (prefers-reduced-motion: no-preference) { .video:hover .play { transform: scale(1.06); } }
</style>
