---
import { num } from '../lib/format';
interface Row { label: string; value: number; highlight?: boolean; reference?: boolean }
interface Props { title: string; rows: Row[]; source: string; unit?: string; compact?: boolean }
const { title, rows, source, unit = '', compact = false } = Astro.props;
const max = Math.max(...rows.map((r) => r.value));
---
<figure class:list={['fig', { compact }]}>
  <table>
    <caption>{title}</caption>
    <tbody>
      {rows.map((r) => (
        <tr class:list={{ hl: r.highlight, ref: r.reference }}>
          <th scope="row">{r.label}</th>
          <td class="bar" aria-hidden="true"><span style={`--w:${(r.value / max) * 100}%`}></span></td>
          <td class="val">{num(r.value)}{unit}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <figcaption class="mono">Πηγή: {source}</figcaption>
</figure>
<style>
  .fig { width: 100%; }
  table { width: 100%; border-collapse: collapse; }
  caption { text-align: left; font-weight: 600; font-size: var(--fs-small); padding-bottom: var(--s-3); }
  th { text-align: left; font-weight: 400; font-size: var(--fs-small); padding: var(--s-1) var(--s-3) var(--s-1) 0; white-space: nowrap; width: 1%; }
  .bar { width: 100%; padding: var(--s-1) 0; }
  .bar span { display: block; height: 0.875rem; width: var(--w); background: var(--bar); }
  .val { font-family: var(--font-mono); font-size: var(--fs-num); text-align: right; padding-left: var(--s-3); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .hl th { font-weight: 600; }
  .hl .val { font-weight: 600; color: var(--accent); }
  .hl .bar span { background: var(--accent); }
  .ref .bar span { background: var(--bar-ref); }
  figcaption { margin-top: var(--s-3); }
  @media (prefers-reduced-motion: no-preference) {
    .bar span { animation: grow var(--dur-draw) var(--ease-out) both; animation-delay: 220ms; transform-origin: left; }
  }
  @keyframes grow { from { transform: scaleX(0.02); } to { transform: scaleX(1); } }
  @media (max-width: 480px) { th { white-space: normal; width: 34%; } }
</style>
