---
import Wordmark from './Wordmark.astro';
import { copy } from '../lib/copy';
---
<footer class="foot">
  <div class="wrap inner">
    <Wordmark tone="marble" size="1.5rem" />
    <p class="statement">{copy.footer.statement}</p>
    <p class="follow">
      {copy.footer.follow} <strong>{copy.footer.handle}</strong>:
      <span class="links">{copy.footer.links.map((l) => <a href={l.href} rel="me noopener">{l.label}</a>)}</span>
    </p>
    <p class="legal"><a href="/aporrito/">{copy.footer.privacy}</a></p>
  </div>
</footer>
<style>
  .foot { background: var(--foot-bg); color: var(--foot-fg); border-top: var(--hair) solid var(--rule); margin-top: var(--s-9); }
  .inner { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--s-6); padding-block: var(--s-7); }
  .statement, .follow { font-size: var(--fs-small); }
  .statement { max-width: 46ch; }
  .follow { color: var(--foot-muted); }
  .legal { grid-column: 1 / -1; font-size: var(--fs-small); color: var(--foot-muted); }
  .legal a { color: var(--foot-muted); }
  .follow strong { color: var(--foot-fg); font-weight: 500; }
  .follow a { color: var(--foot-fg); display: inline-block; padding-block: var(--s-2); }
  .links { display: inline-flex; flex-wrap: wrap; column-gap: 1.1em; margin-left: 0.4em; }
  .follow a:hover { text-decoration-color: var(--foot-accent); }
  .foot :global(::selection) { background: var(--foot-fg); color: var(--foot-bg); }
  @media (max-width: 760px) { .inner { grid-template-columns: 1fr; gap: var(--s-4); } }
</style>
