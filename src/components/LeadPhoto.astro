---
// One graded black-and-white photo per lead story, as in the videos. Always credited.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; credit: string; position?: string; eager?: boolean }
const { src, alt, credit, position = '50% 30%', eager = false } = Astro.props;
---
<figure class="photo">
  <Image src={src} alt={alt} widths={[480, 800, 1200, 1600]} sizes="(min-width: 960px) 52vw, 100vw"
    loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} style={`object-position:${position}`} />
  <figcaption class="mono">Φωτογραφία: {credit}</figcaption>
</figure>
<style>
  .photo { margin: 0; }
  .photo :global(img) { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; background: var(--surface); filter: grayscale(1) contrast(1.04); }
  figcaption { margin-top: var(--s-2); text-transform: none; letter-spacing: 0.04em; }
</style>
