---
import { copy } from '../lib/copy';
---
<p class="notice" role="note">
  <span class="long">{copy.sample}</span><span class="short">{copy.sampleShort}</span>
</p>
<style>
  .notice { background: var(--c-marble-deep); color: var(--fg-soft); font-size: 0.8125rem; padding: var(--s-2) var(--gutter); text-align: center; }
  .short { display: none; }
  @media (max-width: 640px) { .long { display: none; } .short { display: inline; } }
</style>
