---
// Slim newsletter signup, placed where people actually are (top of the homepage, end of each article).
// The full closing band at the bottom stays for those who scroll that far.
import { copy } from '../lib/copy';
interface Props { id: string; contained?: boolean }
const { id, contained = false } = Astro.props;
---
<aside class:list={['strip', { contained }]} aria-label={copy.strip.title}>
  <div class:list={['in', { wrap: !contained }]}>
    <p class="say"><strong>{copy.strip.title}</strong> <span>{copy.strip.body}</span></p>
    <form method="post" action="/api/subscribe" class="nl">
      <label class="visually-hidden" for={`nl-${id}`}>{copy.closing.label}</label>
      <div class="row">
        <input id={`nl-${id}`} name="email" type="email" autocomplete="email" inputmode="email" required placeholder="onoma@email.gr" />
        <button type="submit">{copy.closing.submit}</button>
      </div>
      <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
    </form>
  </div>
</aside>
<style>
  .strip { background: var(--surface); border-block: var(--hair) solid var(--rule); }
  .in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 26rem); gap: var(--s-3) var(--s-6); align-items: center; padding-block: var(--s-4); }
  .say { line-height: 1.4; min-width: 0; }
  .say strong { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); margin-right: var(--s-2); }
  .say span { color: var(--fg-soft); }
  .row { display: flex; border: var(--hair) solid var(--rule-strong); background: var(--bg); }
  input { flex: 1; min-width: 0; font: inherit; padding: var(--s-3) var(--s-4); background: var(--bg); color: var(--fg); border: 0; border-radius: 0; }
  input::placeholder { color: var(--fg-muted); }
  input:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  button { font: 500 var(--fs-body) var(--font-text); background: var(--fg); color: var(--bg); border: 0; padding: var(--s-3) var(--s-5); cursor: pointer; white-space: nowrap; transition: background-color var(--dur-quick) ease-out; }
  button:hover { background: var(--accent); color: var(--c-marble); }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .contained { border: var(--hair) solid var(--rule); }
  .contained .in { grid-template-columns: minmax(0, 1fr); padding: var(--s-5); }
  @media (max-width: 860px) { .in { grid-template-columns: minmax(0, 1fr); } }
</style>
